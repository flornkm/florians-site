# Central Icons License Key
# Get your license key from Central Icons and replace the placeholder below
CENTRAL_LICENSE_KEY=your_central_icons_license_key_here
OPENAI_API_KEY=your_openai_api_key
FIREBASE_ADMIN_CERT=your_firebase_admin_cert
FIREBASE_DATABASE_URL=your_firebase_database_url

# Runs sync (Strava → /api/runs). See scripts/strava-auth.ts to obtain the refresh token.
WORKOUTS_API_KEY=bearer_secret_for_the_apple_shortcut
CRON_SECRET=bearer_secret_for_the_vercel_cron
STRAVA_CLIENT_ID=your_strava_api_client_id
STRAVA_CLIENT_SECRET=your_strava_api_client_secret
STRAVA_REFRESH_TOKEN=your_strava_refresh_token
