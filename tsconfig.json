{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client", "bun"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@public": ["./public"]
    }
  },
  "exclude": ["dist", "node_modules"]
}
